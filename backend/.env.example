APP_ENV=production
HOST=127.0.0.1
PORT=8001
RELOAD=false

MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=proffi
MONGO_MAX_POOL_SIZE=20
# Server selection timeout (ms); increase if Atlas is slow to answer
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# После исправления TLS/OpenSSL на VPS: true (отключит tlsAllowInvalidCertificates для mongodb+srv)
# MONGO_TLS_STRICT=true

JWT_SECRET=change-this-to-a-long-random-secret
ENABLE_TEST_SEED=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://example.com,https://www.example.com

# Optional: regex for subdomains if needed
# CORS_ORIGIN_REGEX=https:\/\/.*\.example\.com

# Optional object storage integration
EMERGENT_LLM_KEY=

# Admin panel API (header X-Admin-Token)
ADMIN_TOKEN=admin
