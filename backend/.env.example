# =============================================================================
# Proffi backend — production на VPS (SQLite + SQLAlchemy async)
# Скопируйте на сервере:  cp .env.example .env  &&  nano .env
#
# --- Где «данные к базе»? (вместо Mongo user / password / cluster) ----------
# SQLite — это ОДИН ФАЙЛ на сервере (например app.db). Отдельного логина/пароля
# к СУБД нет: доступ = права ОС на этот файл (у процесса uvicorn, чаще www-data).
# Вся «строка подключения» — это только DATABASE_URL ниже.
# Имя «базы» в смысле Mongo (DB_NAME) не задаётся: все таблицы внутри этого файла.
# Таблицы создаются при старте приложения (SQLAlchemy create_all).
#
# УДАЛИТЕ из .env всё про Mongo, если переносили старый файл:
#   MONGO_URL, DB_NAME, MONGO_MAX_POOL_SIZE, MONGO_SERVER_SELECTION_TIMEOUT_MS
# Иначе они просто игнорируются, но путают при сопровождении.
# =============================================================================

# ---------- Runtime ----------
APP_ENV=production
HOST=127.0.0.1
PORT=8001
RELOAD=false

# ---------- SQLite (файл app.db) ----------
# Async-драйвер: sqlite+aiosqlite
# Абсолютный путь на VPS (рекомендуется для systemd + www-data):
DATABASE_URL=sqlite+aiosqlite:////var/www/proffi/backend/app.db
#
# Если переменную не задавать — по умолчанию будет файл app.db в каталоге backend
# (относительный путь в URL собирается из расположения db.py).
#
# Права: пользователь сервиса (www-data) должен писать в app.db и в каталог uploads/:
#   sudo chown -R www-data:www-data /var/www/proffi/backend/app.db /var/www/proffi/backend/uploads

# ---------- Auth (JWT для приложения) ----------
JWT_SECRET=<СЛУЧАЙНАЯ_ДЛИННАЯ_СТРОКА_МИНИМУМ_32_СИМВОЛА>
ENABLE_TEST_SEED=false
# Пароль специалиста Sancan (+79031416581, sale@sancan.ru) при локальном `python -m seed` из каталога backend
# SEED_SANCAN_SPECIALIST_PASSWORD=ваш_секрет

# ---------- CORS (браузерные запросы к API) ----------
# Сайты, с которых идёт запрос к API (через запятую, без пробелов вокруг запятой).
CORS_ORIGINS=https://proffi.sancan.ru,https://admin.proffi.sancan.ru

# Опционально: добавить один origin в дефолтный список (если используете)
# FRONTEND_URL=https://proffi.sancan.ru

# Опционально: regex для поддоменов (только если нужен)
# CORS_ORIGIN_REGEX=https:\/\/.*\.sancan\.ru

# Expo / dev: разрешить все origin (только development)
# CORS_ALLOW_ALL_DEV=true

# ---------- Email OTP (Gmail: App Password, не обычный пароль аккаунта) ----------
# Если SMTP_HOST пуст — код OTP пишется в stdout (journalctl).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sancan.shop@gmail.com
# SMTP_PASSWORD=<16-символьный_пароль_приложения_Google>
# SMTP_FROM=sancan.shop@gmail.com
# SMTP_ENCRYPTION=tls
# (альтернатива: SMTP_USE_TLS=true — если SMTP_ENCRYPTION не задан)
#
# Для порта 465 обычно: SMTP_ENCRYPTION=ssl

# ---------- Админка /api/admin (заголовок X-Admin-Token) ----------
ADMIN_TOKEN=<СИЛЬНЫЙ_СЕКРЕТ_АДМИНКИ_НЕ_admin>

# ---------- Прочее (опционально) ----------
# Интеграция object storage Emergent; можно оставить пустым
EMERGENT_LLM_KEY=

# Отладка SQL в логах (обычно выключено)
# SQL_ECHO=false
