# Скопировать на сервере в .env:
#   cd /var/www/proffi/backend && cp env.vps.template .env && nano .env
# Замените JWT_SECRET и ADMIN_TOKEN на свои длинные случайные строки.

APP_ENV=production
HOST=127.0.0.1
PORT=8001
RELOAD=false

DATABASE_URL=sqlite+aiosqlite:////var/www/proffi/backend/app.db

JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_AT_LEAST_32_CHARS
ENABLE_TEST_SEED=false

CORS_ORIGINS=https://proffi.sancan.ru,https://admin.proffi.sancan.ru
# FRONTEND_URL=https://proffi.sancan.ru

ADMIN_TOKEN=CHANGE_ME_STRONG_ADMIN_SECRET_NOT_admin

EMERGENT_LLM_KEY=
