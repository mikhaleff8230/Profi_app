# Скопировать на сервере перед сборкой админки:
#   cd /var/www/proffi/admin && cp env.vps.template .env && nano .env
# Затем: npm ci && npm run build
#
# Origin бэкенда (тот же домен, где Nginx отдаёт /api на FastAPI). Без суффикса /api.
VITE_API_BASE=https://proffi.sancan.ru

# Не задавайте здесь боевой ADMIN_TOKEN: Vite встраивает VITE_* в клиентский JS.
# На экране входа введите тот же токен, что в backend .env как ADMIN_TOKEN.
# VITE_ADMIN_TOKEN=
