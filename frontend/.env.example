# --- Локальная разработка (CRA) ---
REACT_APP_API_URL=http://127.0.0.1:8001
REACT_APP_API_PORT=8001
REACT_APP_API_NAMESPACE=proffi

# --- Прод на VPS (один домен + Nginx /api) ---
# REACT_APP_API_URL=https://treabo.ru
# REACT_APP_API_NAMESPACE=proffi
# (если задан полный URL, порт ниже не используется — см. src/api.js)

WDS_SOCKET_PORT=3000
ENABLE_HEALTH_CHECK=false

# Laravel WebSockets (Proffi realtime chat)
REACT_APP_PUSHER_KEY=proffi-local-key
REACT_APP_PUSHER_HOST=127.0.0.1
REACT_APP_PUSHER_PORT=6001
REACT_APP_PUSHER_SCHEME=http

# Временный автологин в prod-сборке (только если явно true; небезопасно — см. auth.jsx)
# REACT_APP_AUTOLOGIN=true
# REACT_APP_AUTOLOGIN_PHONE=+10000000001
# REACT_APP_AUTOLOGIN_PASSWORD=admin123
