# Скопировать на сервере в .env перед сборкой:
#   cd /var/www/proffi/frontend && cp env.vps.template .env && nano .env
# Затем: npm ci && npm run build
#
# REACT_APP_API_URL — origin сайта (без /api). Nginx проксирует /api на бэкенд.
# Если фронт и API на одном домене — укажите тот же https:// что в браузере.

REACT_APP_API_URL=https://proffi.sancan.ru

# Порт бэкенда не нужен, если задан полный URL выше (для dev без URL можно раскомментировать).
# REACT_APP_API_PORT=8001

WDS_SOCKET_PORT=3000
ENABLE_HEALTH_CHECK=false
