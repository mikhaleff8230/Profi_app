{
  "expo": {
    "name": "Treabo. Кабинет мастера",
    "slug": "treabo-specialist",
    "version": "1.0.14",
    "orientation": "portrait",
    "scheme": "treabo-specialist",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo-specialist.png",
    "splash": {
      "image": "./assets/treabo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.treabo.specialist",
      "icon": "./assets/logo-specialist.png"
    },
    "android": {
      "package": "ru.treabo.specialist",
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-specialist.png",
        "backgroundColor": "#D9F36B"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Treabo использует геолокацию, чтобы показывать задания рядом с вами."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Treabo нужен доступ к фото для аватара, портфолио и файлов в заданиях."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-specialist.png",
          "color": "#D9F36B",
          "defaultChannel": "messages"
        }
      ],
      "expo-sqlite"
    ],
    "owner": "sancans-team",
    "extra": {
      "eas": {
        "projectId": "89f81370-2336-4a65-bdec-3130cc8bac3d"
      }
    }
  }
}
